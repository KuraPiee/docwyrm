datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum GitProvider {
  GITHUB
  GITLAB
  GENERIC
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
  CONFLICT
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique @db.VarChar(64)
  name        String       @db.VarChar(255)
  avatarUrl   String?      @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  projects    Project[]

  @@map("organizations")
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  name         String       @db.VarChar(255)
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]

  @@map("users")
}

model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role         @default(EDITOR)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Project {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  slug           String       @db.VarChar(64)
  name           String       @db.VarChar(255)
  description    String?
  isPublic       Boolean      @default(false) @map("is_public")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docSpaces      DocSpace[]

  @@unique([organizationId, slug])
  @@map("projects")
}

model DocSpace {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String          @map("project_id") @db.Uuid
  slug                 String          @db.VarChar(64)
  title                String          @db.VarChar(255)
  gitProvider          GitProvider     @default(GITHUB) @map("git_provider")
  gitRepoUrl           String          @map("git_repo_url")
  gitBranch            String          @default("main") @map("git_branch") @db.VarChar(128)
  gitBasePath          String          @default("") @map("git_base_path") @db.VarChar(255)
  gitAuthType          String          @default("pat") @map("git_auth_type") @db.VarChar(32)
  gitAuthCredentialId  String?         @map("git_auth_credential_id")
  lastSyncedCommitSha  String?         @map("last_synced_commit_sha") @db.VarChar(64)
  syncStatus           SyncStatus      @default(IDLE) @map("sync_status")
  lastSyncError        String?         @map("last_sync_error")
  lastSyncedAt         DateTime?       @map("last_synced_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docs                 Doc[]
  searchQueries        SearchQuery[]

  @@unique([projectId, slug])
  @@map("doc_spaces")
}

model Doc {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docSpaceId  String       @map("doc_space_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  slug        String       @db.VarChar(128)
  title       String       @db.VarChar(255)
  filePath    String       @map("file_path") @db.VarChar(512)
  orderIndex  Int          @default(0) @map("order_index")
  isPublished Boolean      @default(true) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  docSpace    DocSpace     @relation(fields: [docSpaceId], references: [id], onDelete: Cascade)
  parent      Doc?         @relation("DocHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Doc[]        @relation("DocHierarchy")
  versions    DocVersion[]
  embeddings  Embedding[]

  @@unique([docSpaceId, filePath])
  @@map("docs")
}

model DocVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId          String   @map("doc_id") @db.Uuid
  gitCommitSha   String   @map("git_commit_sha") @db.VarChar(64)
  contentMdx     String   @map("content_mdx")
  rawFrontmatter Json     @default("{}") @map("raw_frontmatter")
  authorName     String?  @map("author_name") @db.VarChar(255)
  authorEmail    String?  @map("author_email") @db.VarChar(255)
  committedAt    DateTime @map("committed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  doc            Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@map("doc_versions")
}

model Embedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId       String                 @map("doc_id") @db.Uuid
  chunkIndex  Int                    @map("chunk_index")
  content     String
  headingPath String[]               @map("heading_path")
  embedding   Unsupported("vector")
  tokenCount  Int?                   @map("token_count")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  doc         Doc                    @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}

model SearchQuery {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docSpaceId    String   @map("doc_space_id") @db.Uuid
  queryText     String   @map("query_text")
  resultsCount  Int      @map("results_count")
  hadGoodAnswer Boolean  @default(true) @map("had_good_answer")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  docSpace      DocSpace @relation(fields: [docSpaceId], references: [id], onDelete: Cascade)

  @@map("search_queries")
}
