# ==============================================================================
# Docwyrm Production & Development Environment Configuration (docwyrm.com)
# ==============================================================================

# Server & Domain Configuration
PORT=4000
# In Production: https://docwyrm.com | In Local Development: http://localhost:3000
FRONTEND_URL=https://docwyrm.com
NEXT_PUBLIC_API_URL=https://docwyrm.com

# GitHub OAuth Application Credentials
# GitHub Developer Setup Guide for docwyrm.com:
# 1. Navigate to: https://github.com/settings/developers
# 2. Select "OAuth Apps" -> "New OAuth App"
# 3. Application name: Docwyrm
# 4. Homepage URL: https://docwyrm.com
# 5. Application description: The Git-Native Modern Documentation Platform
# 6. Authorization callback URL: https://docwyrm.com/api/auth/github/callback
#    (For local testing: http://localhost:4000/api/auth/github/callback)
# 7. Generate a Client Secret and paste below:
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=https://docwyrm.com/api/auth/github/callback

# Session & Token Secret (Generate a strong 32+ character random key)
AUTH_SECRET=docwyrm_secure_session_key_production_change_me_32char

# PostgreSQL Database (Optional / Multi-tenant storage)
DATABASE_URL=postgresql://docwyrm_admin:docwyrm_secret_password@localhost:5432/docwyrm?schema=public
