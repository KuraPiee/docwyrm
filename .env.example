# ==============================================================================
# Docwyrm Environment Configuration Template
# ==============================================================================

# API Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# GitHub OAuth Application Credentials
# Setup Guide:
# 1. Open https://github.com/settings/developers
# 2. Click "OAuth Apps" -> "New OAuth App"
# 3. Application name: Docwyrm
# 4. Homepage URL: http://localhost:3000
# 5. Authorization callback URL: http://localhost:4000/api/auth/github/callback
# 6. Click "Register application" and copy Client ID & Client Secret below
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Session & Token Secret (Generate a strong 32+ character key)
AUTH_SECRET=docwyrm_secure_session_key_production_change_me_32char

# PostgreSQL Database (Phase 0 & Multi-tenant storage)
DATABASE_URL=postgresql://docwyrm:docwyrm_dev_password@localhost:5432/docwyrm?schema=public
